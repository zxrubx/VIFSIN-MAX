# токен бота из @MasterBot (или business.max.ru → ваш бот)
BOT_TOKEN=your_token_here
DB_PATH=data/reports.db

# пароль админки: обязателен, дефолтные/простые значения (admin, change_me, ...) админка не примет
ADMIN_PASSWORD=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8000

# необязательно: MAX user_id сотрудников через запятую — им придёт "Новое обращение"
NOTIFY_USER_IDS=
# необязательно: контакт администрации, показывается в /privacy
SUPPORT_CONTACT=
# лимит обращений от одного пользователя в час
RATE_LIMIT_PER_HOUR=5
